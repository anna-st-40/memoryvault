# Path to your video archive on the host machine
MEDIA_DIR=/path/to/your/videos

# Public-facing URL of the backend (used by the browser to load thumbnails/video).
# If accessing from a remote machine, set this to http://<host-ip>:8000
PUBLIC_API_URL=http://localhost:8000

# Shared across backend and worker
MEMORYVAULT_BASE=/data
THUMBNAILS_DIR=/app/thumbnails
DATABASE_URL=sqlite:////app/database/app.db
LOG_LEVEL=INFO
