# Path to your video archive on the host machine
MEDIA_DIR=/path/to/your/videos

# Shared across backend and worker
MEMORYVAULT_BASE=/data
THUMBNAILS_DIR=/app/thumbnails
DATABASE_URL=sqlite:////app/database/app.db
LOG_LEVEL=INFO

# Ollama LLM settings
# Point OLLAMA_URL at a remote machine running Ollama
OLLAMA_URL=http://<ollama-host>:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_TIMEOUT_SEC=120

# Embedding model for RAG (shared by backend and worker)
EMBEDDING_MODEL=microsoft/harrier-oss-v1-0.6b
