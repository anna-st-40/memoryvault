{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Start Backend",
            "type": "shell",
            "command": "poetry run uvicorn app.main:app --reload",
            "options": {
                "cwd": "${workspaceFolder}/backend",
                "env": {
                    "DATABASE_URL": "sqlite:///${workspaceFolder}/database/app.db",
                    "MEMORYVAULT_BASE": "${workspaceFolder}/test_volume",
                    "THUMBNAILS_DIR": "${workspaceFolder}/thumbnails"
                }
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Worker",
            "type": "shell",
            "command": "python -m app.main",
            "options": {
                "cwd": "${workspaceFolder}/worker",
                "env": {
                    "DATABASE_URL": "sqlite:///${workspaceFolder}/database/app.db",
                    "MEMORYVAULT_BASE": "${workspaceFolder}/test_volume",
                    "THUMBNAILS_DIR": "${workspaceFolder}/thumbnails"
                }
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start Frontend",
            "type": "shell",
            "command": "npm run dev",
            "options": {
                "cwd": "${workspaceFolder}/frontend"
            },
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "Start All",
            "dependsOn": [
                "Start Backend",
                "Start Worker",
                "Start Frontend"
            ],
            "problemMatcher": []
        }
    ]
}
